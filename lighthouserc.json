{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/pages-preview.mjs",
      "startServerReadyPattern": "FrontKit preview ready",
      "url": [
        "http://127.0.0.1:4173/frontkit/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 650000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
